{
  "expo": {
    "name": "Ges Boutique",
    "slug": "ges-boutique",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#081648"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.gesboutique.lafia",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#081648",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "minSdkVersion": 21
    },
    "newArchEnabled": false,
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Autoriser Ges Boutique à accéder à votre caméra pour scanner les codes-barres.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "33ae3edf-feb7-4edf-9ab9-d1248270366b"
      }
    }
  }
}
